{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slopsearx.invalid/contracts/o03/source-receipt-1.0.0.schema.json",
  "title": "Prospective immutable native source receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_kind", "plan_id", "git_commit", "dirty", "tree_sha256", "files", "binary", "toolchain", "configuration_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "receipt_kind": {"const": "native_source"},
    "plan_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*$"},
    "git_commit": {"type": "string", "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"},
    "dirty": {"const": false},
    "tree_sha256": {"$ref": "#/$defs/sha256"},
    "files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "git_blob", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "git_blob": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "sha256": {"$ref": "#/$defs/sha256"}}}},
    "binary": {"type": "object", "additionalProperties": false, "required": ["sha256", "size_bytes", "path"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 1}, "path": {"type": "string", "minLength": 1}}},
    "toolchain": {"type": "object", "additionalProperties": false, "required": ["rustc", "cargo", "target", "lockfile_sha256"], "properties": {"rustc": {"type": "string", "minLength": 1}, "cargo": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}, "lockfile_sha256": {"$ref": "#/$defs/sha256"}}},
    "configuration_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
