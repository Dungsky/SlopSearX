{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slopsearx.invalid/contracts/o03/runtime-receipt-1.0.0.schema.json",
  "title": "Prospective native experiment runtime receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "run_id",
    "plan_id",
    "binary",
    "source",
    "toolchain",
    "configuration",
    "authority",
    "clock",
    "reservation",
    "accounting",
    "outcome"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "receipt_kind": {
      "const": "native_runtime"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]*$"
    },
    "binary": {
      "$ref": "#/$defs/artifact"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rustc",
        "cargo",
        "target",
        "lockfile_sha256"
      ],
      "properties": {
        "rustc": {
          "type": "string",
          "minLength": 1
        },
        "cargo": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "lockfile_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "redacted",
        "effective_keys"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "redacted": {
          "const": true
        },
        "effective_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "reservation_id",
        "authorization_sha256",
        "scope",
        "status"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "reservation_id": {
          "type": "string",
          "minLength": 1
        },
        "authorization_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "authorized",
            "denied"
          ]
        }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "started_unix_ms",
        "finished_unix_ms",
        "monotonic_elapsed_ms",
        "deadline_unix_ms"
      ],
      "properties": {
        "source": {
          "enum": [
            "fixed",
            "system"
          ]
        },
        "started_unix_ms": {
          "type": "integer",
          "minimum": 0
        },
        "finished_unix_ms": {
          "type": "integer",
          "minimum": 0
        },
        "monotonic_elapsed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "deadline_unix_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_requests",
        "max_cost_microusd",
        "deadline_unix_ms"
      ],
      "properties": {
        "max_requests": {
          "type": "integer",
          "minimum": 0
        },
        "max_cost_microusd": {
          "type": "integer",
          "minimum": 0
        },
        "deadline_unix_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests_reserved",
        "requests_dispatched",
        "requests_settled",
        "requests_unresolved",
        "requests_released",
        "cost_microusd_reserved",
        "actual_cost"
      ],
      "properties": {
        "requests_reserved": {
          "type": "integer",
          "minimum": 0
        },
        "requests_dispatched": {
          "type": "integer",
          "minimum": 0
        },
        "requests_settled": {
          "type": "integer",
          "minimum": 0
        },
        "requests_unresolved": {
          "type": "integer",
          "minimum": 0
        },
        "requests_released": {
          "type": "integer",
          "minimum": 0
        },
        "cost_microusd_reserved": {
          "type": "integer",
          "minimum": 0
        },
        "actual_cost": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "microusd"
              ],
              "properties": {
                "status": {
                  "const": "known"
                },
                "microusd": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reason_code"
              ],
              "properties": {
                "status": {
                  "const": "unknown"
                },
                "reason_code": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      }
    },
    "outcome": {
      "enum": [
        "accepted",
        "rejected",
        "inconclusive",
        "blocked",
        "failure",
        "outcome_unknown"
      ]
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason_code",
        "terminal_evidence"
      ],
      "properties": {
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "terminal_evidence": {
          "$ref": "#/$defs/artifact"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size_bytes",
        "path"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit",
        "dirty",
        "tree_sha256",
        "files"
      ],
      "properties": {
        "git_commit": {
          "type": "string",
          "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "dirty": {
          "const": false
        },
        "tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "git_blob",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "git_blob": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "minItems": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "accepted"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "authority": {
            "properties": {
              "status": {
                "const": "authorized"
              }
            }
          },
          "accounting": {
            "properties": {
              "actual_cost": {
                "properties": {
                  "status": {
                    "const": "known"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "requests_unresolved": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "failure"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "failure"
        ]
      }
    },
    {
      "if": {
        "required": [
          "failure"
        ]
      },
      "then": {
        "properties": {
          "outcome": {
            "const": "failure"
          }
        },
        "required": [
          "outcome"
        ]
      }
    }
  ]
}
