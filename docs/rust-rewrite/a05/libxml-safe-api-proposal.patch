+#[cfg(test)]
+static A05_REFUSALS: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+
+#[cfg(test)]
+mod a05_policy_tests {
+  use super::*;
+
+  #[test]
+  fn a05_refusal_callback_abi_and_real_context_dispatch() {
+    crate::init_parser();
+    let mut output = ptr::NonNull::<xmlParserInput>::dangling().as_ptr();
+    let result = unsafe {
+      refuse_external_resource(ptr::null_mut(), ptr::null(), ptr::null(), 0, 0, &mut output)
+    };
+    assert_eq!(result, xmlParserErrors_XML_IO_LOAD_ERROR);
+    assert!(output.is_null());
+    assert_eq!(unsafe {
+      refuse_external_resource(ptr::null_mut(), ptr::null(), ptr::null(), 0, 0, ptr::null_mut())
+    }, xmlParserErrors_XML_IO_LOAD_ERROR);
+
+    let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+    listener.set_nonblocking(true).unwrap();
+    let canary = std::env::temp_dir().join(format!("a05-loader-canary-{}", std::process::id()));
+    std::fs::write(&canary, b"<canary>FILE-MUST-NOT-BE-READ</canary>").unwrap();
+    let inputs = [
+      format!("file://{}", canary.display()),
+      format!("http://{}/canary", listener.local_addr().unwrap()),
+      "ftp://127.0.0.1/no".to_owned(),
+      canary.to_string_lossy().into_owned(),
+    ];
+    for url in inputs {
+      let context = ParserContext::new(ParseFormat::XML).unwrap();
+      let url = CString::new(url).unwrap();
+      let before = A05_REFUSALS.load(std::sync::atomic::Ordering::SeqCst);
+      let doc = unsafe {
+        xmlCtxtSetResourceLoader(context.ptr.as_ptr(), Some(refuse_external_resource), ptr::null_mut());
+        xmlCtxtReadFile(context.ptr.as_ptr(), url.as_ptr(), ptr::null(), 0)
+      };
+      assert!(doc.is_null());
+      assert!(A05_REFUSALS.load(std::sync::atomic::Ordering::SeqCst) > before,
+        "libxml2 must actually invoke the installed loader");
     }
+    assert!(matches!(listener.accept(), Err(e) if e.kind() == std::io::ErrorKind::WouldBlock));
+    std::fs::remove_file(canary).unwrap();
   }
+
+  #[test]
+  fn a05_error_collector_restores_thread_state_on_panic() {
+    crate::init_parser();
+    let before_handler = unsafe { *__xmlStructuredError() };
+    let before_data = unsafe { *__xmlStructuredErrorContext() };
+    let outcome = std::panic::catch_unwind(|| {
+      let _collector = ErrorCollector::install();
+      panic!("controlled unwind while collector owns its callback data");
+    });
+    assert!(outcome.is_err());
+    assert_eq!(unsafe { *__xmlStructuredError() }.map(|f|f as usize), before_handler.map(|f|f as usize));
+    assert_eq!(unsafe { *__xmlStructuredErrorContext() }, before_data);
+  }
